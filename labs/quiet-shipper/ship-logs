#!/usr/bin/env bash
set -euo pipefail
conf=/etc/log-shipper.conf
. "$conf"
: "${DEST:?DEST not set in $conf}"
if ! command -v jq >/dev/null 2>&1; then
  echo "ship-logs: jq is required but not found on PATH" >&2
  exit 1
fi
: > "$DEST"
while IFS= read -r line; do
  jq -c '{id, msg}' <<<"$line" >> "$DEST"
done < /var/log/app.log
