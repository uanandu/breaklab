#!/usr/bin/env bash
set -euo pipefail
LOCK=/var/run/infra/apply.lock
SRC=/infra/resources.yaml

if [ -f "$LOCK" ]; then
  pid=$(sed -n 's/^PID=//p' "$LOCK")
  started=$(sed -n 's/^STARTED=//p' "$LOCK")
  echo "refusing to run: lock held by PID $pid (started $started)"
  exit 1
fi

mkdir -p "$(dirname "$LOCK")"
printf 'PID=%s\nSTARTED=%s\n' "$$" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$LOCK"
trap 'rm -f "$LOCK"' EXIT

path=$(sed -n 's/^path: *//p' "$SRC")
content=$(sed -n 's/^content: *//p' "$SRC")
echo "$content" > "$path"
echo "applied: $path"
