#!/usr/bin/env bash
set -euo pipefail
replicas=$(sed -n 's/^replicas: *//p' /infra/worker.yaml)
queue=$(sed -n 's/^queue: *//p' /infra/worker.yaml)
mkdir -p /etc/worker
VARS='${REPLICAS} ${QUEUE}'
REPLICAS="$replicas" QUEUE="$queue" envsubst "$VARS" < /infra/templates/worker.env.tmpl > /etc/worker/worker.env
