---
import "@astryxdesign/core/reset.css";
import "@astryxdesign/core/astryx.css";
import PublicProfile from "../../components/PublicProfile";

// One physical shell file for any username — same pattern as
// labs/[id].astro (design.md "Astro builds shells, not content").
export function getStaticPaths() {
  return [{ params: { name: "_" } }];
}
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>BreakLab — profile</title>
  </head>
  <body>
    <main>
      <PublicProfile client:load />
    </main>
  </body>
</html>
